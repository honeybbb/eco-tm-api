# ====== 토큰 ======
JWT_SECRET=
JWT_REFRESH_SECRET=

# ====== CORS ======
ALLOWED_ORIGINS=http://localhost:3000

# ====== 메일 (NHN Cloud Email SMTP) ======
# NHN 콘솔 → Notification → Email → SMTP 설정 에서 발급
MAIL_SMTP_HOST=smtp.toast.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# ====== 메일 비밀번호 암호화 키 (AES-256-GCM, 32B hex) ======
# 발급: openssl rand -hex 32
# 분실 시 저장된 SMTP 비밀번호를 복호화할 수 없음 → 안전하게 백업 보관
MAIL_ENC_KEY=

# ====== 메일 워커 ======
# 멀티 인스턴스 환경에선 1개 노드만 Y 로 설정 (중복 발송 방지)
MAIL_WORKER_ENABLED=Y
MAIL_WORKER_INTERVAL_MS=5000
MAIL_WORKER_BATCH_SIZE=10
MAIL_WORKER_MAX_ATTEMPTS=3
MAIL_WORKER_BACKOFF_MS=2000
